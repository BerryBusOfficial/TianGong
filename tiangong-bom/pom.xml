<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.berrybus-official</groupId>
    <artifactId>tiangong-bom</artifactId>
    <version>0.0.2</version>
    <packaging>pom</packaging>

    <name>TianGong Bill of Materials</name>
    <description>统一管理天工模块与第三方依赖版本。根 pom 通过 import 引入。</description>
    <url>https://github.com/BerryBusOfficial/TianGong</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Wu-Xi-Cheng</id>
            <name>Wu-Xi-Cheng</name>
            <email>mcht1023@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/BerryBusOfficial/TianGong.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/BerryBusOfficial/TianGong.git</developerConnection>
        <url>https://github.com/BerryBusOfficial/TianGong</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/BerryBusOfficial/TianGong/issues</url>
    </issueManagement>

    <distributionManagement>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com/api/v1/publisher</url>
        </repository>
    </distributionManagement>

    <properties>
        <logback.version>1.5.34</logback.version>
        <jackson.version>2.21.4</jackson.version>
        <lombok.version>1.18.46</lombok.version>
        <junit.version>5.12.2</junit.version>
        <lettuce.version>7.6.0.RELEASE</lettuce.version>
        <jGrapht.version>1.5.3</jGrapht.version>
        <asm.version>9.7.1</asm.version>
        <mcp.version>2.0.0</mcp.version>
        <!-- 4.8.198：低于它的旧版本在 Spring Boot 3.2+ 可执行 jar（nested: 文件系统 / NestedPath）
             下扫描会抛 "Unable to resolve nested path"，fat jar 启动即失败；勿降级 -->
        <classgraph.version>4.8.198</classgraph.version>
        <bytebuddy.version>1.18.10</bytebuddy.version>
        <!-- Apache 2.0；运行时只带 slf4j-api，quartz / spring 都是它的 test scope，不会传递进来 -->
        <cronutils.version>9.2.1</cronutils.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 天工模块：外部消费者导入本 BOM 后无需逐项写版本 -->
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-retrieval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-guardrail</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-trace</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-llm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-boot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-history</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-bytebuddy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-math</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-skill</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>tiangong-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>annotations-annotation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>annotations-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.berrybus-official</groupId>
                <artifactId>annotations-scanner</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <!-- logback 整族管理：只写 classic 时，混用第二套 BOM 会让 core 落到对方版本 ——
                 典型撕裂 classic 1.5.34 + core 1.5.6（NoClassDefFoundError） -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <!-- Jackson 整族管理（jackson-bom 一次管全：core/databind/annotations/各 dataformat）。
                 只逐个列 core/annotations 时，混用第二套 BOM 会出现 core 2.21 + databind 2.17 撕裂 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <!-- JUnit 全家族统一版本（junit-bom 一次管全）。<br>
                 <b>为什么不能只写 junit-jupiter/junit-jupiter-api</b>：混用两套 BOM
                 （如同时 import tiangong-bom 与 spring-boot-dependencies）时，
                 未被本表管理的 engine/params/platform 会落到另一套 BOM 的版本上 ——
                 典型症状是 jupiter 5.12 + platform 1.10 撕裂，surefire 报
                 「TestEngine with ID 'junit-jupiter' failed to discover tests」。 -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>${lettuce.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jgrapht</groupId>
                <artifactId>jgrapht-core</artifactId>
                <version>${jGrapht.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.classgraph</groupId>
                <artifactId>classgraph</artifactId>
                <version>${classgraph.version}</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${bytebuddy.version}</version>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-core</artifactId>
                <version>${mcp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cronutils</groupId>
                <artifactId>cron-utils</artifactId>
                <version>${cronutils.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>central-publish</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
