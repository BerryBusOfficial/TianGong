<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.berrybus-official</groupId>
        <artifactId>tiangong-annotations</artifactId>
        <version>0.0.2-SNAPSHOT</version>
    </parent>

    <artifactId>annotations-processor</artifactId>

    <name>TianGong Annotations Processor</name>
    <description>注解处理器：编译期扫描框架注解生成元数据</description>

    <dependencies>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>annotations-annotation</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup</groupId>
            <artifactId>javapoet</artifactId>
            <version>1.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- 处理器模块自身编译不触发注解处理（services 指向自身类，避免自引用加载失败） -->
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
