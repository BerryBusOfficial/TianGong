<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.berrybus-official</groupId>
        <artifactId>tiangong</artifactId>
        <version>0.0.2</version>
    </parent>

    <artifactId>tiangong-core</artifactId>

    <name>TianGong Agent Core</name>
    <description>框架核心：容器/扫描/注入/线程/配置/函数注册</description>

    <dependencies>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>tiangong-common</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>tiangong-bytebuddy</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>annotations-annotation</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>annotations-processor</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>annotations-scanner</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>tiangong-memory</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>tiangong-llm</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>tiangong-protocol</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>tiangong-trace</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.berrybus-official</groupId>
            <artifactId>tiangong-guardrail</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- Optional<T> 结构化输出反序列化需要 Jdk8Module；findAndAddModules 才会注册它 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jgrapht</groupId>
            <artifactId>jgrapht-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cronutils</groupId>
            <artifactId>cron-utils</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.berrybus-official</groupId>
                            <artifactId>annotations-annotation</artifactId>
                            <version>${project.parent.version}</version>
                        </path>
                        <path>
                            <groupId>io.github.berrybus-official</groupId>
                            <artifactId>annotations-processor</artifactId>
                            <version>${project.parent.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>